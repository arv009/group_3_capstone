Capstone Guide.pdf
Capstone_Project_Options.pdf

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local tool configs ---
.claude/
.agents/
