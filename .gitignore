# --- Secrets: never commit ---
.env
.streamlit/secrets.toml

# --- Data (too large for Git; download with scripts/download_data.py, see README) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.db
*.sqlite

# --- Model artifacts (rebuild with the notebooks) ---
models/*
!models/.gitkeep

